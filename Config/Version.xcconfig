// Единственное место, где задаётся версия приложения.
// Меняешь здесь — меняется во всех таргетах: iOS, watchOS, tvOS,
// Network Extension, Widget и Tests.
//
// APP_VERSION      -> MARKETING_VERSION      -> CFBundleShortVersionString
// APP_BUILD_NUMBER -> CURRENT_PROJECT_VERSION -> CFBundleVersion
//
// App Store требует, чтобы APP_BUILD_NUMBER рос с каждой загрузкой
// в пределах одной APP_VERSION.

APP_VERSION = 1.0.1
APP_BUILD_NUMBER = 1
